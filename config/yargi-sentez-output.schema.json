{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_markdown": {
      "type": "string",
      "minLength": 500
    },
    "atif_maddeleri": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "kunye": { "type": "string", "minLength": 1 },
          "verified_full_text": { "type": "boolean" },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "atif": { "type": "string", "minLength": 1 },
                "kanun": { "type": "string", "minLength": 1 },
                "madde": { "type": "string", "minLength": 1 },
                "baglam": { "type": "string" }
              },
              "required": ["atif", "kanun", "madde", "baglam"]
            }
          }
        },
        "required": ["document_id", "kunye", "verified_full_text", "citations"]
      }
    },
    "query_count": { "type": "integer", "minimum": 0 },
    "full_text_count": { "type": "integer", "minimum": 0 }
  },
  "required": ["report_markdown", "atif_maddeleri", "query_count", "full_text_count"]
}
